# Copy to .env on this server (cp .env.example .env). Use IDENTICAL values on both private servers.
# Private IPv4 addresses from the EC2 console (instance -> Details -> Private IPv4 address).
PRIVATE1_IP=10.0.128.10
PRIVATE2_IP=10.0.128.20
# Database login. Set a long random password BEFORE the first start of MongoDB on
# private server 1: MongoDB only reads these once, when it creates an empty data volume.
MONGO_USERNAME=admin
MONGO_PASSWORD=change-me-to-a-long-random-password
MONGO_DB=my-db
# APP_TAG is added and updated automatically by the Jenkins pipeline. Leave it out.
