# Copy to .env on the nginx (public) server:  cp .env.example .env
# Private IPv4 addresses of the two app servers (EC2 console -> instance -> Details).
PRIVATE1_IP=10.0.128.10
PRIVATE2_IP=10.0.128.20
# HTTPS (optional until you run ./get-cert.sh). DOMAIN is a name that points to this
# server's Elastic IP, e.g. a free DuckDNS name. CERT_EMAIL gets expiry warnings.
DOMAIN=
CERT_EMAIL=
