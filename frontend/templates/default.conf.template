# Frontend nginx. Rendered into /etc/nginx/conf.d/default.conf when the container
# starts (official nginx image templating). Only variables named HTTPS_* are
# substituted; nginx's own $variables are left alone (see NGINX_ENVSUBST_FILTER
# in the Dockerfile).
#
#   :80   redirects to HTTPS (except the container healthcheck)
#   :443  serves the static frontend and proxies /api and /health to the backend

# "app" is the backend service name from docker-compose. Docker's embedded DNS
# (127.0.0.11) resolves it, and because the address sits in a variable nginx
# looks it up at request time. So the frontend starts fine even if the backend
# is down, and keeps working when the backend container is recreated with a new IP.
resolver 127.0.0.11 valid=10s ipv6=off;

# ---------------------------------------------------------------- HTTP -> HTTPS
server {
    listen 80;
    server_name _;
    server_tokens off;

    # Plain-HTTP liveness endpoint for the Docker healthcheck.
    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        # HTTPS_REDIRECT_PORT_SUFFIX is empty for port 443, or e.g. ":8443" when
        # the HTTPS port is published on a different host port (NGINX_HTTPS_PORT).
        return 301 https://$host${HTTPS_REDIRECT_PORT_SUFFIX}$request_uri;
    }
}

# ----------------------------------------------------------------------- HTTPS
server {
    listen 443 ssl;
    server_name _;

    # Created by /docker-entrypoint.d/25-self-signed-cert.sh on first start, or
    # supply your own tls.crt / tls.key in the certs volume.
    ssl_certificate     /etc/nginx/certs/tls.crt;
    ssl_certificate_key /etc/nginx/certs/tls.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 1m;

    gzip on;
    gzip_min_length 256;
    gzip_types text/css text/javascript application/javascript application/json text/plain;

    # Security headers. nginx does NOT inherit these into a location that defines
    # its own add_header, so don't add add_header inside the locations below.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Strict-Transport-Security is deliberately NOT set. Browsers apply HSTS to the
    # whole hostname (ports are ignored), so on "localhost" it would force https on
    # your other local services and, with a self-signed certificate, remove the
    # "proceed anyway" option. Enable it only on a real domain with a trusted certificate.

    # Backend address. The port must match the PORT the Node app listens on (.env).
    set $backend http://app:3000;

    # Shared proxy settings (inherited by the proxy locations below).
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout    60s;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Backend ---
    location /api/ {
        proxy_pass $backend;
    }

    # App + MongoDB health (answered by the backend).
    location = /health {
        proxy_pass $backend;
    }

    # --- Frontend (static files) ---
    location / {
        try_files $uri $uri/ =404;
        # Always revalidate (ETag -> 304) so a new deploy is picked up immediately.
        expires -1;
    }
}
